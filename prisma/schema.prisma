// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String          @map("password_hash")
  createdAt    DateTime        @default(now()) @map("created_at")

  caretakers   BabyCaretaker[]
  bowelLogs    BowelMovement[]
  growthLogs   GrowthRecord[]
  napSessions  NapSession[]

  @@map("users")
}

model Baby {
  id           String               @id @default(uuid())
  name         String
  birthDate    DateTime             @map("birth_date")
  gender       String               // 'male' | 'female' | 'other'
  createdAt    DateTime             @default(now()) @map("created_at")

  caretakers   BabyCaretaker[]
  bowelLogs    BowelMovement[]
  growthLogs   GrowthRecord[]
  vaccines     VaccineApplication[]
  appointments MedicalAppointment[]
  reminders    Reminder[]
  feedings     FeedingLog[]
  napSessions  NapSession[]
  napSettings  NapSettings?

  @@map("babies")
}

model BabyCaretaker {
  id     String @id @default(uuid())
  babyId String @map("baby_id")
  userId String @map("user_id")
  role   String @default("EDITOR")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([babyId, userId])
  @@map("baby_caretakers")
}

model BowelMovement {
  id          String   @id @default(uuid())
  babyId      String   @map("baby_id")
  userId      String   @map("user_id")
  loggedAt    DateTime @default(now()) @map("logged_at")
  type        String   @default("POOP") // 'POOP' | 'PEE' | 'BOTH'
  color       String?
  consistency String?
  notes       String?

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bowel_movements")
}

model GrowthRecord {
  id          String   @id @default(uuid())
  babyId      String   @map("baby_id")
  userId      String   @map("user_id")
  measuredAt  DateTime @default(now()) @map("measured_at")
  weightGrams Int      @map("weight_grams")
  heightCm    Float    @map("height_cm")
  headCircCm  Float?   @map("head_circ_cm")
  source      String   @default("HOME")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("growth_records")
}

model Vaccine {
  id              String               @id @default(uuid())
  name            String
  description     String?
  targetAgeMonths Int                  @map("target_age_months")

  applications    VaccineApplication[]

  @@map("vaccines")
}

model VaccineApplication {
  id          String   @id @default(uuid())
  babyId      String   @map("baby_id")
  vaccineId   String   @map("vaccine_id")
  appliedAt   DateTime @default(now()) @map("applied_at")
  lotNumber   String?  @map("lot_number")
  location    String?
  sideEffects String?  @map("side_effects")

  baby    Baby    @relation(fields: [babyId], references: [id], onDelete: Cascade)
  vaccine Vaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@map("vaccine_applications")
}

model MedicalAppointment {
  id              String   @id @default(uuid())
  babyId          String   @map("baby_id")
  doctorName      String   @map("doctor_name")
  specialty       String?
  type            String   @default("ROUTINE")
  description     String?
  appointmentDate DateTime @map("appointment_date")
  preNotes        String?  @map("pre_notes")
  postNotes       String?  @map("post_notes")
  status          String   @default("SCHEDULED")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("medical_appointments")
}

model Reminder {
  id        String   @id @default(uuid())
  babyId    String   @map("baby_id")
  title     String
  content   String?
  color     String   @default("yellow")
  createdAt DateTime @default(now()) @map("created_at")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model FeedingLog {
  id         String   @id @default(uuid())
  babyId     String   @map("baby_id")
  side       String   // 'LEFT_BREAST' | 'RIGHT_BREAST' | 'BOTTLE'
  durationSec Int     @map("duration_sec")
  amountMl   Int?     @map("amount_ml")
  startedAt  DateTime @default(now()) @map("started_at")
  notes      String?

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("feeding_logs")
}

model NapSession {
  id             String    @id @default(uuid())
  babyId         String    @map("baby_id")
  userId         String    @map("user_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  durationMinutes Int?     @map("duration_minutes")
  endReason      String?   @map("end_reason") // 'manual', 'cry_detected', 'timer_limit'
  whiteNoiseUsed String?   @map("white_noise_used")
  createdAt      DateTime  @default(now()) @map("created_at")

  baby           Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  @@map("nap_sessions")
}

model NapSettings {
  id               String   @id @default(uuid())
  babyId           String   @unique @map("baby_id")
  micSensitivity   String   @default("medium") @map("mic_sensitivity") // 'low', 'medium', 'high'
  defaultWhiteNoise String  @default("white_noise") @map("default_white_noise")
  
  baby             Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("nap_settings")
}
